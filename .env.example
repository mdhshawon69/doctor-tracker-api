# Port the Express API listens on locally. Vercel ignores this (it invokes the
# exported handler instead of `app.listen`).
PORT=4000

# MongoDB Atlas connection string, including the database name.
# For a local mongod use: mongodb://127.0.0.1:27017/doctor-tracker
# On Atlas, allow Vercel's egress: add 0.0.0.0/0 to the cluster IP access list.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/doctor-tracker?retryWrites=true&w=majority

# Long random string used to sign the session cookie. It is the only auth
# secret the API needs — user accounts and password hashes live in MongoDB.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=replace-me-with-a-long-random-string

# Comma-separated list of browser origins allowed to call the API with cookies.
# Use the deployed frontend URL in production, e.g. https://app.example.com
FRONTEND_ORIGIN=http://localhost:3000

# Cookie behaviour. Leave these commented out unless you need to override them.
# The API automatically uses "none" + Secure in production when FRONTEND_ORIGIN
# is https, which is required when the frontend is on a different domain.
# COOKIE_SAMESITE=lax
# COOKIE_SECURE=false
# COOKIE_DOMAIN=
# SESSION_COOKIE_NAME=doctor_tracker_session

# Set to true when the API runs behind a proxy that terminates TLS.
# Vercel does this, and production defaults to true.
# TRUST_PROXY=true
