# Port the Express API listens on. Heroku sets this automatically.
PORT=4000

# MongoDB Atlas connection string, including the database name.
# For a local mongod use: mongodb://127.0.0.1:27017/doctor-tracker
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/doctor-tracker?retryWrites=true&w=majority

# Long random string used to sign the session cookie.
# Generate one with: openssl rand -base64 32
# This must be the same value as AUTH_SECRET in the frontend .env.local.
AUTH_SECRET=replace-me-with-a-long-random-string

# Comma-separated list of browser origins allowed to call the API with cookies.
FRONTEND_ORIGIN=http://localhost:3000

# Cookie behaviour. Leave the defaults for local development.
# Secure defaults to true in production when FRONTEND_ORIGIN uses https.
# COOKIE_SAMESITE=lax
# COOKIE_SECURE=false
# COOKIE_DOMAIN=

# Seeded administrator account. Used by `npm run seed`.
ADMIN_NAME=Dara Whitfield
ADMIN_EMAIL=admin@careguide.app
ADMIN_PASSWORD=Admin@12345
